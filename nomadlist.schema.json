{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yat's List NomadList",
  "type": "object",
  "required": [
    "dataset",
    "updated_at",
    "cities"
  ],
  "properties": {
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "city",
          "country",
          "region",
          "cost_usd_month",
          "internet_mbps",
          "nomad_score",
          "visa"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "stable slug, never changes"
          },
          "city": {
            "type": "string"
          },
          "city_zh": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "country_zh": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "enum": [
              "Southeast Asia",
              "East Asia",
              "Europe",
              "Caucasus",
              "Middle East",
              "Middle East / Europe",
              "Americas",
              "Africa"
            ]
          },
          "cost_usd_month": {
            "type": "number",
            "description": "estimated total monthly cost for one nomad, USD"
          },
          "rent_1br_usd_month": {
            "type": "number"
          },
          "coworking_usd_month": {
            "type": "number"
          },
          "internet_mbps": {
            "type": "number"
          },
          "safety_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "english_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "nomad_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "visa": {
            "type": "object",
            "properties": {
              "cn_passport_type": {
                "type": "string"
              },
              "cn_max_stay_days": {
                "type": "number"
              },
              "has_nomad_visa": {
                "type": "boolean"
              },
              "nomad_visa_link": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "official application URL; set only when taken from an official government page"
              },
              "policy_last_change": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "date the visa policy last changed, from official source; null = not yet tracked"
              }
            }
          },
          "data_tier": {
            "type": "string",
            "enum": [
              "verified_v1",
              "checked",
              "seed_v2"
            ],
            "description": "verified_v1 = v1 seed batch; checked = cross-checked against >=2 independent sources by the hourly collector; seed_v2 = estimate pending verification"
          },
          "neighborhoods": {
            "type": "array",
            "description": "District layer (learned from StayHere): same city, different districts can differ 2x in rent. Pick a district before a city.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "name_en": {
                  "type": "string"
                },
                "rent_1br_usd_month": {
                  "type": "number"
                },
                "monthly_total_cny_frugal": {
                  "type": "number",
                  "description": "frugal-tier total monthly cost in CNY when sourced (e.g. StayHere China cities)"
                },
                "rent_cny_month": {
                  "type": "number"
                },
                "vibe": {
                  "type": "string"
                },
                "best_for": {
                  "type": "string"
                },
                "coworking_density": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "note": {
                  "type": "string"
                },
                "listings": {
                  "type": "array",
                  "description": "Third layer: specific compounds/places, only when field-checked or sourced; empty when none recorded.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "rent_cny_month": {
                        "type": "number"
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "best_months_nums": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "description": "best_months parsed to month numbers for programmatic filtering"
          },
          "avoid_months": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "description": "months to avoid (e.g. Chiang Mai burning season [3,4]); omitted when unknown"
          },
          "cost_breakdown": {
            "type": "object",
            "description": "Itemized monthly cost where sourced (StayHere-style for China cities; filled gradually for checked cities)",
            "properties": {
              "currency": {
                "type": "string"
              },
              "tier": {
                "type": "string"
              },
              "total": {
                "type": "number"
              },
              "stay": {
                "type": "number"
              },
              "food": {
                "type": "number"
              },
              "transport": {
                "type": "number"
              },
              "utilities_internet": {
                "type": "number"
              },
              "coworking": {
                "type": "number"
              },
              "misc": {
                "type": "number"
              },
              "basis": {
                "type": "string"
              }
            }
          },
          "fields_provenance": {
            "type": "object",
            "description": "Per-field confidence for cost_usd_month / internet_mbps / visa: {confidence 0-1, basis, as_of}. checked~0.8, verified_v1~0.6, seed_v2~0.4; visa 0.5 until policy_last_change is set from an official page.",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    },
    "changelog_url": {
      "type": "string"
    },
    "lite_url": {
      "type": "string"
    },
    "city_url_template": {
      "type": "string"
    }
  }
}